# Copy to .env (chmod 600). Never commit the real file.
LIBRARY=example            # stack = example-slims, proxy network = example-edge
DB_NAME=slims
DB_PASS=                   # app user (openssl rand -base64 24)
DB_ROOT_PASS=              # MariaDB root, only used for init/maintenance
SLIMS_TAG=9.8.0
# Optional: admin password set on first start only. Remove it from .env afterwards.
ADMIN_INITIAL_PASSWORD=
